# EditorConfig for dotfiles
# https://editorconfig.org

root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# Shell scripts (.sh, .bash)
[*.{sh,bash}]
indent_style = space
indent_size = 2

# JSON files
[*.json]
indent_style = space
indent_size = 2

# YAML files
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
indent_style = space
indent_size = 2

# Config files
[*.{conf,toml}]
indent_style = space
indent_size = 2

# Lua files (Neovim config)
[*.lua]
indent_style = space
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab
